{
  "name": "Teknopark GPU Scraper",
  "build": {
    "context": ".",
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--gpus", "all"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "remoteUser": "root"
}